{
  "name": "tri-map",
  "private": true,
  "version": "0.1.0",
  "description": "TriMap: a fast, static finder for full-distance, half-distance and T100 triathlons worldwide.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "vite build",
    "build:fixtures": "vite build --mode fixtures --outDir dist-fixtures",
    "preview": "vite preview",
    "preview:fixtures": "vite preview --outDir dist-fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "screenshots": "playwright test --project=screenshots",
    "validate:data": "tsx scripts/validate-data.ts",
    "refresh:ironman": "tsx scripts/refresh-ironman.ts",
    "refresh:t100": "tsx scripts/refresh-t100.ts",
    "refresh:registration": "tsx scripts/refresh-registration.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
